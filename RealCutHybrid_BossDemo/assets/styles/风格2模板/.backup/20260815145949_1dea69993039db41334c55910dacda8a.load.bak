                "language": "zh-CN",
                "content": "{\"attribute\":{\"extra\":{\"asr_id\":\"b1dbf5f1-ba89-4f56-8987-a55fcbc3925c\",\"language\":\"zh-CN\"}},\"utterances\":[{\"end_time\":2100,\"start_time\":200,\"text\":\"这个衣长是83的这个\",\"words\":[{\"end_time\":480,\"start_time\":200,\"text\":\"这个\"},{\"end_time\":840,\"start_time\":480,\"text\":\"衣长\"},{\"end_time\":1040,\"start_time\":840,\"text\":\"是\"},{\"end_time\":1640,\"start_time\":1040,\"text\":\"83\"},{\"end_time\":1840,\"start_time\":1640,\"text\":\"的\"},{\"end_time\":2080,\"start_time\":1840,\"text\":\"这个\"}]},{\"end_time\":3100,\"start_time\":2100,\"text\":\"你看裙摆\",\"words\":[{\"end_time\":2300,\"start_time\":2100,\"text\":\"你\"},{\"end_time\":2500,\"start_time\":2300,\"text\":\"看\"},{\"end_time\":3100,\"start_time\":2580,\"text\":\"裙摆\"}]},{\"end_time\":4933,\"start_time\":3366,\"text\":\"它裙摆是一个不规则的\",\"words\":[{\"end_time\":3446,\"start_time\":3366,\"text\":\"它\"},{\"end_time\":3846,\"start_time\":3606,\"text\":\"裙摆\"},{\"end_time\":4046,\"start_time\":3886,\"text\":\"是\"},{\"end_time\":4206,\"start_time\":4046,\"text\":\"一个\"},{\"end_time\":4686,\"start_time\":4206,\"text\":\"不规则\"},{\"end_time\":4926,\"start_time\":4686,\"text\":\"的\"}]},{\"end_time\":5333,\"start_time\":4933,\"text\":\"它跟这样子吧\",\"words\":[{\"end_time\":5013,\"start_time\":4933,\"text\":\"它\"},{\"end_time\":5213,\"start_time\":5053,\"text\":\"跟\"},{\"end_time\":6573,\"start_time\":6173,\"text\":\"这样\"},{\"end_time\":6653,\"start_time\":6573,\"text\":\"子\"},{\"end_time\":6933,\"start_time\":6653,\"text\":\"吧\"}]},{\"end_time\":7566,\"start_time\":5933,\"text\":\"249块钱上车\",\"words\":[{\"end_time\":6853,\"start_time\":5933,\"text\":\"249\"},{\"end_time\":7013,\"start_time\":6853,\"text\":\"块\"},{\"end_time\":7093,\"start_time\":7013,\"text\":\"钱\"},{\"end_time\":7573,\"start_time\":7093,\"text\":\"上车\"}]},{\"end_time\":9566,\"start_time\":8000,\"text\":\"整个的这个裙子的做工\",\"words\":[{\"end_time\":8240,\"start_time\":8000,\"text\":\"整个\"},{\"end_time\":8400,\"start_time\":8240,\"text\":\"的\"},{\"end_time\":8640,\"start_time\":8400,\"text\":\"这个\"},{\"end_time\":8960,\"start_time\":8640,\"text\":\"裙子\"},{\"end_time\":9200,\"start_time\":8960,\"text\":\"的\"},{\"end_time\":9560,\"start_time\":9200,\"text\":\"做工\"}]},{\"end_time\":11299,\"start_time\":9566,\"text\":\"大家一定要看清楚哦真的\",\"words\":[{\"end_time\":9806,\"start_time\":9566,\"text\":\"大家\"},{\"end_time\":9966,\"start_time\":9806,\"text\":\"一定\"},{\"end_time\":10086,\"start_time\":9966,\"text\":\"要\"},{\"end_time\":10286,\"start_time\":10086,\"text\":\"看\"},{\"end_time\":10526,\"start_time\":10286,\"text\":\"清楚\"},{\"end_time\":10646,\"start_time\":10566,\"text\":\"哦\"},{\"end_time\":10886,\"start_time\":10726,\"text\":\"真\"},{\"end_time\":11286,\"start_time\":10886,\"text\":\"的\"}]},{\"end_time\":13166,\"start_time\":11366,\"text\":\"你们如果看不明白玩不明\",\"words\":[{\"end_time\":11686,\"start_time\":11366,\"text\":\"你们\"},{\"end_time\":11926,\"start_time\":11686,\"text\":\"如果\"},{\"end_time\":12126,\"start_time\":11926,\"text\":\"看\"},{\"end_time\":12286,\"start_time\":12126,\"text\":\"不\"},{\"end_time\":12566,\"start_time\":12286,\"text\":\"明白\"},{\"end_time\":12886,\"start_time\":12686,\"text\":\"玩\"},{\"end_time\":13446,\"start_time\":12886,\"text\":\"不明\"}]}]}",
